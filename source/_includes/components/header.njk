{% set ditherUrl = ['/icons/', accentColor, '.png' ] | join %}
{% set text = displayHeading or name or title %}
{% set long = (text | length) > 20 %}
{% set subtitle = jobTitle %}

<header class="dither {% if long %} long {% endif %}" style="background-image: url('{{ ditherUrl }}');">
    
    {% if 'people' in page.url %}
    <div class="navgroup">
      <a href="/who-we-are">Who We Are</a>
      {% endif %}
      <h1>{{ text }}</h1>
      {% if 'people' in page.url %}
    </div>
    {% endif %}

    {% if tableOfContents %}
      {% include "./tableOfContents.njk" %}
    {% endif %}

    {% if headerImage %}
      <img src="{{ headerImage }}" alt="{{ headerAlt }}">
    {% endif %}

</header>