{% from '../macros.njk' import colors %}

<footer id="footer">
    <div class="easy-flex">
        <address>
            <div><strong>{{ site.title }}</strong></div>
            <div class="location">
                {% if site.address %} {{ site.address }} <br> {% endif %}
                {% if site.address_2 %} {{ site.address_2 }} {% endif %}
            </div>
            <div class="contact"><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
        </address>
        <a href="#top">↑ Jump to Top</a>
    </div>

    {% if site.mission %}
        <p>{{ site.mission }}</p>
    {% endif %}

    <div class="easy-flex">
        <a href="/">Newsletter</a>
    </div>

    {% set navId = 'footer-menu' %}
    {% include './sitemap.njk' %}

    <div class="easy-flex flex-start">
        <span class="font-sans">© {{ thisYear }} by SCALES-OKN</span>
        <a href="/accessibility">Accessibility Statement</a>
        <a href="/privacy">Privacy Policy</a>
    </div>

    {% if false %}
        {% if site.social_links %}
        <section>
            <em>Links</em>
            <ul>
            {% for link in site.social_links %}
                <li><a href="{{ link.url }}" target="_blank">{{ link.name }}</a></li>
            {% endfor %}
            </ul>
        </section>
        {% endif %}

        {% if site.credits %}
        <section>
            <em>Credits</em>
            <ul>
            {% for genre, credits in site.credits | groupby("genre") %}
                <li>
                    {{ genre | title }}:
                    {% for credit in credits %}
                        <a href="{{ credit.url }}" target="_blank">{{ credit.name }}</a>
                    {% endfor %}
                </li>
            {% endfor %}
            </ul>
        </section>
        {% endif %}
    {% endif %}
</footer>